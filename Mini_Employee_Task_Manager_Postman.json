{
  "info": {
    "name": "Mini Employee Task Manager API",
    "description": "Generated Postman Collection for Chatbot, RAG, and Auth endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@test.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test@test.com\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Chatbot",
      "item": [
        {
          "name": "Send Chat Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"message\": \"What are my pending tasks?\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/chat",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "chat"]
            }
          }
        }
      ]
    },
    {
      "name": "RAG (Document Q&A)",
      "item": [
        {
          "name": "Upload PDF",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "http://localhost:5000/api/rag/upload",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rag", "upload"]
            }
          }
        },
        {
          "name": "Ask Question",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer YOUR_TOKEN_HERE" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"documentId\": \"INSERT_DOCUMENT_ID_HERE\",\n    \"question\": \"What is the main topic of this document?\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/rag/ask",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "rag", "ask"]
            }
          }
        }
      ]
    }
  ]
}
